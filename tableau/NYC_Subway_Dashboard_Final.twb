            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7929' id='31' type-v2='text' w='37284' x='62714' y='0'>
            <formatted-text>
              <run fontcolor='#555555' fontsize='10'>Key Findings:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Late night has the highest complaint rate: 8.78 complaints per 100,000 rides.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Coney Island–Stillwell Av leads the station ranking: 38.37 complaints per   100,000 rides.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Stations in lower-income Census tracts had higher average complaint rates.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
